{
  "name": "kammel-backend",
  "version": "1.0.0",
  "description": "API REST de Kammel (Node.js, Express, Sequelize, MySQL/MariaDB)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node src/scripts/db-setup.js",
