# --- Serveur ---
PORT=4000
# 32 caractères aléatoires minimum (en production le serveur refuse de démarrer sans) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# NODE_ENV=production      # en ligne : cookies Secure, HSTS, secret obligatoire
# TRUST_PROXY=1            # derrière un proxy (Render) : lire la vraie adresse IP
# PROXY_SECRET=            # déploiement Cloudflare Pages → Render (voir DEPLOY.md)
# SERVE_WEB=false          # ne pas servir web/dist (site hébergé ailleurs)
# CORS_ORIGINS=            # autres origines autorisées, séparées par des virgules (rarement utile)

# --- Base de données ---
# En local (MySQL Workbench / XAMPP) :
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kammel
# En ligne (TiDB Cloud, etc.) : une seule URL + chiffrement
# DATABASE_URL=mysql://utilisateur:motdepasse@hote:4000/kammel
# DB_SSL=true

# --- Coach IA (optionnel) ---
# Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- E-mails : mot de passe oublié de l'équipe (optionnel) ---
# Sans ces valeurs, les codes sont affichés dans la console du serveur.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kammel <votre.adresse@gmail.com>
