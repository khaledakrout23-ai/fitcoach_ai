# --- Serveur ---
PORT=4000
JWT_SECRET=change-moi-par-une-longue-phrase-secrete

# --- Base de données MySQL (les mêmes infos que dans MySQL Workbench) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fitcoach

# --- Coach IA (optionnel) ---
# Clé gratuite : https://aistudio.google.com/apikey
# Sans clé, le coach fonctionne en mode simple (réponses préparées, programme par règles).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- E-mails : vérification de l'adresse et mot de passe oublié ---
# Gmail : activez la validation en 2 étapes puis créez un « mot de passe d'application »
# (https://myaccount.google.com/apppasswords) et collez-le dans SMTP_PASS (16 lettres, sans espaces).
# Sans ces valeurs, les codes sont affichés dans la console du serveur (mode développement).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FitCoach AI <votre.adresse@gmail.com>
